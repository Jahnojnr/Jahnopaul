# ---------------------------------------------------------------------------
# Supabase — where to get these values
# ---------------------------------------------------------------------------
# 1. Create a project at https://supabase.com/dashboard (free tier is enough).
# 2. Open the project, then either:
#      - click "Connect" at the top of the project page, or
#      - go to Settings -> API Keys
# 3. Copy the Project URL and the publishable key.
#
# Newer projects show:  Publishable key  sb_publishable_…   Secret key  sb_secret_…
# Older projects show:  anon (public)     eyJ…              service_role  eyJ…
# Both spellings are accepted below. Fill in one pair, leave the other empty.

# Project URL, for example https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Safe to expose to the browser. Either name works; the app reads whichever is set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security. Used only by the contact route.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Administration
# ---------------------------------------------------------------------------
# Comma-separated allowlist of administrator email addresses. Create the user in
# Supabase Authentication -> Users, then put the same address here.
# This is the bootstrap path before any row exists in public.admin_users.
ADMIN_EMAILS=

# Development-only read-only dashboard preview using sample content.
# On by default in development when Supabase is not configured.
# Always off in production. Set to "false" to hide the preview button explicitly.
ADMIN_PREVIEW_MODE=

# ---------------------------------------------------------------------------
# Contact email (optional; inquiries are still stored when this is empty)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Salt used when deriving the rate-limit key. Change this in production.
CONTACT_RATE_LIMIT_SALT=

# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
