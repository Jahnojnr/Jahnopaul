# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and publishable (anonymous) key. Safe to expose to the browser;
# Row Level Security still decides what each visitor can read.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security. Used only by the contact route and
# by scripts. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Administration
# ---------------------------------------------------------------------------
# Comma-separated allowlist of administrator email addresses. This is the
# bootstrap path before any row exists in public.admin_users. Keep it to one
# address unless you genuinely need a second administrator.
ADMIN_EMAILS=

# Development-only read-only dashboard preview using sample content.
# Ignored when NODE_ENV is "production" or when Supabase is configured.
ADMIN_PREVIEW_MODE=false

# ---------------------------------------------------------------------------
# Contact email (optional; inquiries are still stored when this is empty)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Salt used when deriving the rate-limit key. Change this in production.
CONTACT_RATE_LIMIT_SALT=

# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
